# ---- Database (PostgreSQL) ----
# DATABASE_URL = pooled connection (app runtime); DIRECT_URL = direct (migrations).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
#
# Neon (free tier): Console → Connection Details.
#   DATABASE_URL = the *pooled* host (…-pooler…), add ?sslmode=require&pgbouncer=true
#   DIRECT_URL   = the *direct* host, ?sslmode=require (used for migrations)
# Local Postgres / Supabase work the same way — point both URLs at your instance.

# ---- Auth ----
# Generate a long random value in production: openssl rand -base64 48
# MINIMUM 32 characters in production. Rotating AUTH_SECRET invalidates all sessions.
AUTH_SECRET="dev-insecure-secret-change-me-1234567890"
# Require login + RBAC on every page (required in production — set this).
# AUTH_ENFORCE=true

# ---- ZATCA Fatoora gateway ----
ZATCA_MODE="sandbox"            # sandbox | production
ZATCA_SANDBOX_BASE_URL="https://gw-fatoora.zatca.gov.sa/e-invoicing/developer-portal"
ZATCA_PRODUCTION_BASE_URL="https://gw-fatoora.zatca.gov.sa/e-invoicing/core"

# ---- AI assistant ----
# Pick one backend. Without its key the assistant and AI insights run in a safe
# mock/deterministic mode (no external calls). All four support tool calling,
# so the in-chat actions in lib/ai/tools.ts work on any of them.
# AI_PROVIDER="openrouter"   # openrouter (default) | groq | anthropic | openai
#
# AI_MODEL / AI_FALLBACK_MODEL override the per-provider defaults below.
# AI_MODEL=
#
# OpenRouter — free models, good for development. https://openrouter.ai/keys
# OPENROUTER_API_KEY="sk-or-v1-..."
# OPENROUTER_MODEL="openai/gpt-oss-120b:free"
# OPENROUTER_FALLBACK_MODEL="openai/gpt-oss-20b:free"   # OpenRouter-only routing
#
# Groq (groq.com — inference hosting, not xAI's Grok). Fastest option; use this
# for live demos. https://console.groq.com/keys
# GROQ_API_KEY="gsk_..."
# GROQ_MODEL="llama-3.3-70b-versatile"   # must support tool calling
#
# Anthropic. https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL=
#
# OpenAI. https://platform.openai.com/api-keys
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"

# Optional: transactional email (Resend). Used for password-reset links and
# invoice email delivery (N7). Falls back to console-logging (mock) if unset.
# RESEND_API_KEY=
# EMAIL_FROM="Fatoora Lite Pro <onboarding@yourdomain.com>"

# Optional: force a feature flag globally regardless of any per-company row
# (a kill switch — see lib/flags/registry.ts). "true" or "false"; unset means
# "use the per-company row, or the code default if there isn't one".
# FEATURE_EMAIL_INVOICE_DELIVERY=
# FEATURE_CSV_IMPORT=

# ---- At-rest encryption for ZATCA certificate private keys ----
# REQUIRED in production. Generate with: openssl rand -base64 32
# WARNING: Do NOT reuse AUTH_SECRET here — they serve different purposes.
# Rotating ENCRYPTION_KEY requires re-encrypting all Certificate rows first.
# ENCRYPTION_KEY=

# ---- Cron job authentication (Vercel Cron) ----
# REQUIRED in production. Vercel sends this in Authorization: Bearer <CRON_SECRET>.
# Generate with: openssl rand -base64 32 and set in the Vercel dashboard + here.
# Without this, the /api/cron/zatca-reporting endpoint is open to anyone.
# CRON_SECRET=

# ---- Operator credential (global AI knowledge re-index) ----
# Optional. There is deliberately no platform-admin role in this app, so this
# is the only credential that can trigger POST /api/ai/ingest {scope:"global"}
# over HTTP. Without it, that endpoint is disabled entirely (403) — re-index
# the shared ZATCA corpus at deploy time instead with scripts/ingest-global.ts.
# Generate with: openssl rand -base64 32
# OPERATOR_SECRET=

# ---- Tests ----
# Set to a disposable Postgres to run DB integration tests (skipped otherwise):
# TEST_DATABASE_URL="postgresql://fatoora:fatoora@localhost:5432/fatooralite_test?schema=public"

# ---- Optional: distributed rate limiting (Upstash Redis REST) ----
# Falls back to in-memory (single-instance only) if unset.
# Required for multi-instance / serverless deployments to have shared rate limits.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---- App base URL (server-side) ----
# Your canonical deployed URL, no trailing slash. Used to build Moyasar's
# success_url/callback_url below and as the OpenRouter HTTP-Referer header.
# Note: app/sitemap.ts and app/robots.ts read a *separate* NEXT_PUBLIC_APP_URL
# — pre-existing naming split, not unified here; set both to the same value.
# APP_URL="https://app.yourdomain.com"
# NEXT_PUBLIC_APP_URL="https://app.yourdomain.com"

# ---- Optional: Moyasar payments (KSA) — Pro plan checkout ----
# Without MOYASAR_SECRET_KEY, the app runs fully live on the Free plan —
# POST /api/billing/checkout returns 501 with a friendly message instead of
# erroring. Get keys at https://dashboard.moyasar.com (Settings > API Keys)
# after KYC; set MOYASAR_WEBHOOK_SECRET to the same value you configure as
# the invoice's callback shared secret in the Moyasar dashboard. See
# docs/09-deployment.md's Moyasar section — the webhook payload shape was
# written from docs only (no live test account existed when this was
# built) and should be confirmed against one real sandbox transaction.
# MOYASAR_SECRET_KEY=
# MOYASAR_WEBHOOK_SECRET=

