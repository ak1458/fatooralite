#!/bin/sh
#
# Rejects tool/assistant attribution in commit messages.
#
# Fatoora Lite Pro is engineered software, not an AI demo. Attribution
# trailers make assistants show up in GitHub's contributor graph and
# misrepresent how the product is built.
#
# Enable once per clone:
#   git config core.hooksPath .githooks

msg_file="$1"
[ -f "$msg_file" ] || exit 0

# Strip comment lines before matching so a commented-out example is fine.
body=$(grep -v '^#' "$msg_file")

fail() {
	echo "commit-msg: rejected — $1" >&2
	echo "" >&2
	echo "  Remove the offending line and commit again." >&2
	echo "  See .github/CONTRIBUTING.md > Commits." >&2
	exit 1
}

case "$body" in
	*[Cc]o-[Aa]uthored-[Bb]y*[Cc]laude* | \
	*[Cc]o-[Aa]uthored-[Bb]y*[Aa]nthropic* | \
	*[Cc]o-[Aa]uthored-[Bb]y*[Cc]opilot* | \
	*[Cc]o-[Aa]uthored-[Bb]y*[Cc]ursor* | \
	*[Cc]o-[Aa]uthored-[Bb]y*[Cc]odex* | \
	*[Cc]o-[Aa]uthored-[Bb]y*[Gg]emini* | \
	*[Cc]o-[Aa]uthored-[Bb]y*noreply@anthropic.com* | \
	*[Cc]o-[Aa]uthored-[Bb]y*noreply@openai.com*)
		fail "assistant Co-Authored-By trailer"
		;;
esac

case "$body" in
	*"Generated with"*[Cc]laude* | \
	*"Generated with"*[Cc]odex* | \
	*"Generated with"*[Cc]opilot* | \
	*"Generated by"*[Cc]laude* | \
	*claude.com/claude-code* | \
	*"🤖"*)
		fail "assistant-generated footer or robot sign-off"
		;;
esac

exit 0
